# ============================================================
# AUTO-REPLY HUB — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values:
#   copy .env.example .env
# ============================================================

# --- Server ---
PORT=3000

# --- WhatsApp (Meta Cloud API) ---
# Get these from: https://developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_VERIFY_TOKEN=my-secret-verify-token-change-this
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# --- AI Brain (Google Gemini) ---
# Get this from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- AI System Prompt ---
# This tells the AI who you are and how to reply.
# You can write a multi-line prompt here using \n for new lines.
AI_SYSTEM_PROMPT=You are a helpful business assistant. Reply professionally and concisely.
